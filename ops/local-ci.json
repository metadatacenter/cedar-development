{
  "schemaVersion": 1,
  "statusContext": "cedar/local-ci",
  "profiles": {
    "maven-tests": {
      "exclusive": "java-test-ports"
    },
    "maven": {
      "skip": {
        "Publish the snapshot": "publication, not verification: Actions publishes the snapshot after a push to develop"
      },
      "exclusive": "java-test-ports"
    },
    "embedded-mongo-on-linux": {
      "skip": {
        "Install OpenSSL 1.1 for the embedded MongoDB": "Linux only: the Ubuntu runner lacks the OpenSSL 1.1 the embedded MongoDB 5.0 binary links against, and macOS needs nothing"
      }
    },
    "opensearch": {
      "substitute": {
        "Start OpenSearch": {
          "run": "docker rm -f cedar-local-ci-opensearch >/dev/null 2>&1 || true\ndocker run --detach --name cedar-local-ci-opensearch --publish 29200:9200 --env discovery.type=single-node --env plugins.security.disabled=true --env DISABLE_INSTALL_DEMO_CONFIG=true --env \"OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m\" opensearchproject/opensearch:2.19.1 > \"$RUNNER_TEMP/opensearch-start.log\" 2>&1\n",
          "reason": "the native stack's OpenSearch holds port 9200, so the test instance listens on 29200 under a container name of its own"
        }
      },
      "env": {
        "CEDAR_OPENSEARCH_REST_PORT": "29200"
      },
      "requires": [
        "docker"
      ],
      "cleanup": "docker rm -f cedar-local-ci-opensearch >/dev/null 2>&1 || true"
    }
  },
  "repositories": {
    "cedar-admin-tool": {

<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <profiles>
    <profile>
      <id>cedar</id>
      <!--
        Central comes first. After the Nexus repositories, it was asked for a third-party artifact
        only once each had answered 404, and a build starting from an empty repository spent
        thousands of those misses against Nexus's daily request limit.
      -->
      <repositories>
        <repository>
          <id>central</id>
          <url>https://repo.maven.apache.org/maven2</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
          <id>cedar-maven-dev</id>
          <url>https://nexus.bmir.stanford.edu/repository/cedar-maven-dev/</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository>
          <id>bmir-nexus-releases</id>
          <url>https://nexus.bmir.stanford.edu/repository/releases/</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>cedar</activeProfile>
  </activeProfiles>
  <servers>
    <server>
      <id>cedar-maven-dev</id>
      <username>${env.BMIR_NEXUS_USERNAME}</username>
      <password>${env.BMIR_NEXUS_PASSWORD}</password>
    </server>
    <server>
      <id>bmir-nexus-releases</id>
      <username>${env.BMIR_NEXUS_USERNAME}</username>
      <password>${env.BMIR_NEXUS_PASSWORD}</password>
    </server>
  </servers>
</settings>
